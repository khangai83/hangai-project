# ============================================================
# Supabase тохиргоо (Next.js) — https://supabase.com/dashboard
# Project Settings -> API - хэсгээс авна
# ============================================================
# (1) Энэ файлыг ".env.local" гэж хуулж нэрлэнэ
# (2) Доорх утгуудаа бөглөнө
# cp .env.local.example .env.local
NEXT_PUBLIC_SUPABASE_URL=https://TANII_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tanii_anon_key

# Хэрэглэгчийн нэвтрэлт рүү илгээгдэх OTP кодыг (логийн түвшинд хэвлэх) demo зорилгоор идэвхжүүлэх
# Жинхэнэ SMS илгээхийн тулд Supabase Auth дээр SMS Provider (Twilio) тохируулах шаардлагатай
NEXT_PUBLIC_ENABLE_OTP_LOGGING=true

# Seed script (scripts/seed-supabase.js) ажиллуулах үед хэрэглэгдэнэ.
# Supabase Dashboard -> Settings -> API -> service_role key (нууц — хэзээ ч frontend-д бүү ашигла)
SUPABASE_SERVICE_ROLE_KEY=tanii_service_role_key

# ============================================================
# Facebook агент (n8n) — /api/agent/ingest webhook-ийн нууц түлхүүр
# n8n workflow-д энэ утгыг AGENT_INGEST_KEY-ээр тааруулж тавина.
# ============================================================
AGENT_INGEST_KEY=tanii_n8n_tohiroljin_nguuc_key

# Дараах хувьсагчууд нь n8n-ийн environment дээр тавигдана (энэ апп-д биш):
# FB_GROUP_ID        -> тухайн Facebook группын ID
# FB_ACCESS_TOKEN    -> Facebook Graph API user/page access token
# AGENT_INGEST_URL   -> https://TANII_HOST/api/agent/ingest
# AGENT_INGEST_KEY   -> дээрхтэй ижил нууц түлхүүр


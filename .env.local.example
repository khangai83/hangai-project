# ============================================================
# Supabase тохиргоо (Next.js) — https://supabase.com/dashboard
# Project Settings -> API - хэсгээс авна
# ============================================================
# (1) Энэ файлыг ".env.local" гэж хуулж нэрлэнэ
# (2) Доорх утгуудаа бөглөнө
# cp .env.local.example .env.local
NEXT_PUBLIC_SUPABASE_URL=https://TANII_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tanii_anon_key

# Хэрэглэгчийн нэвтрэлт рүү илгээгдэх OTP кодыг (логийн түвшинд хэвлэх) demo зорилгоор идэвхжүүлэх
# Жинхэнэ SMS илгээхийн тулд Supabase Auth дээр SMS Provider (Twilio) тохируулах шаардлагатай
NEXT_PUBLIC_ENABLE_OTP_LOGGING=true

# Seed script (scripts/seed-supabase.js) ажиллуулах үед хэрэглэгдэнэ.
# Supabase Dashboard -> Settings -> API -> service_role key (нууц — хэзээ ч frontend-д бүү ашигла)
SUPABASE_SERVICE_ROLE_KEY=tanii_service_role_key

# ============================================================
# ☁️ Cloudflare R2 — ЗУРГИЙН САН (Supabase Storage-ийн оронд) 2026-10-02
#
# ЯАГААД: Supabase Free = 1 GB storage + 5 GB/сар egress (зураг гол
# зарцуулалт). Cloudflare R2 = 10 GB storage + egress ҮНЭГҮЙ ✓
#
# ⚠️ ЭДГЭЭР УТГУУД БАЙХГҮЙ Ч САЙТ АЖИЛЛАХ БОЛНО: зураг нь хуучин
#    Supabase Storage руу автоматаар хадгалагдана (нөөц зам) ✓
#
# АЛХАМ (дэлгэрэнгүй: docs/R2_SETUP.md):
#   1) Cloudflare → R2 → Create bucket  (жишээ: zar-media)
#   2) R2 → API → Manage API tokens → Create token
#      (Permissions: Object Read & Write; Scope: тэр bucket)
#   3) Bucket → Settings → Public access → custom domain холбоно
#      (жишээ: img.zarlaa.mn) эсвэл туршилтад r2.dev
#   4) Bucket → Settings → CORS Policy → PUT/GET/HEAD зөвшөөрнө
#   5) Доорх 5 утгыг бөглөнө → npm run check:r2  (бүгд ✅ болно)
# ============================================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=my-zar
# Нийтийн домэйн (төгсгөлд нь `/` БИШ).
#  ⚠️ ХААНААС АВАХ ВЭ: Cloudflare → Storage & databases → R2 → my-zar → Settings
#     · ТУРШИЛТАД : «Public Development URL» → Enable → allow гэж бичээд Allow
#                   → «Public Bucket URL»  (https://pub-1a2b3c.r2.dev)
#     · PRODUCTION: «Custom Domains» → Add → img.zarlaa.mn (санал болгож байна)
#  Дэлгэрэнгүй: docs/R2_SETUP.md §3 · шалгах: npm run check:r2
R2_PUBLIC_BASE=https://img.zarlaa.mn

# ℹ️ S3 API ENDPOINT-ыг БӨГЛӨХ ШААРДЛАГАГҮЙ — код `R2_ACCOUNT_ID`-аас
#    автоматаар `https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com` болгоно
#    (Cloudflare → bucket → Settings → S3 API дээр яг энэ хаяг харагдана).
#    Зөвхөн онцгой тохиолдолд (EU jurisdiction bucket, S3-нийцтэй прокси) дарж бичнэ:
# R2_ENDPOINT=https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com

# (сонголтоор) `check:r2` нь CORS-ыг ЭНЭ домэйнуудаар шалгана (таслалаар).
#  ⚠️ ЯАГААД: presigned PUT-ийг BROWSER илгээдэг тул САЙТЫН домэйн нь R2-ийн
#     CORS `AllowedOrigins`-д БАЙХ ЁСТОЙ. Дутуу бол upload «Failed to fetch» ✗
#  (эсвэл 1 удаагийн туршилтад: npm run check:r2 -- --origin https://…)
#  ⚠️ Эдгээрийг CORS-д ЯГ ИЖИЛ бичнэ — төгсгөлийн `/` БЕЗ (`…app/` → 403 ✗).
#     Dashboard-аас гадна S3 API-аар (`PutBucketCors`) ч болно: docs/R2_SETUP.md §4
# R2_CORS_ORIGIN=http://localhost:3000,https://hangai-project.vercel.app

# (сонголтоор) Migration-уудыг ГАРААР clipboard-д хуулахгүйгээр АВТОМАТААР
# ажиллуулах. Supabase Dashboard -> Account -> Access Tokens -> Generate (sbp_...).
# ⚠️ НУУЦ түлхүүр — зөвхөн локал .env.local-д, git-д хэзээ ч бүү оруул.
# Байвал:      node scripts/apply-schema.js 0012_listing_bathrooms.sql
# Байхгүй бол: npm run migration:copy 0012_listing_bathrooms.sql
#              (SQL нь clipboard-д орж, SQL Editor нээгдэнэ → ⌘A ⌫ → ⌘V → Run)
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxx

# ============================================================
# Verify.MN — бүртгэлийн SMS (MO) баталгаажуулалт
# https://verify.mn → Developer Console → API KEY
# ⚠️ НУУЦ түлхүүр — NEXT_PUBLIC_ угтваргүй, зөвхөн сервер талд ашиглагдана.
# ============================================================
VERIFY_MN_API_KEY=tanii_verify_mn_api_key

# (сонголтоор) verify.mn → манай сервер рүү "шалга" дохио илгээх URL.
# Зөвхөн production (public host) дээр утга учиртай; localhost дээр
# verify.mn хүрч чадахгүй тул браузер 3 секунд тутам өөрөө шалгана (polling).
# VERIFY_MN_CALLBACK_URL=https://tanii-host.mn/api/auth/verify/callback

# (сонголтоор) test/dev орчинд verify.mn-ийг дуурайх өөр base URL
# VERIFY_MN_API_URL=https://api.verify.mn

# (сонголтоор) SMS-ийн баталгаажуулалтын токеныг гарын үсэг зурах secret.
# Тохируулаагүй бол SUPABASE_SERVICE_ROLE_KEY-г ашиглана.
# AUTH_SESSION_SECRET=random-long-secret

